{
  "expo": {
    "name": "Bike Register",
    "slug": "bike-register",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0f1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bikeregister.app",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.bikeregister.app",
      "adaptiveIcon": {
        "backgroundColor": "#0f1220"
      },
      "permissions": ["NOTIFICATIONS"]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-notifications"],
    "extra": {
      "apiBaseUrl": "https://bike-register-api.YOUR-SUBDOMAIN.workers.dev"
    }
  }
}
